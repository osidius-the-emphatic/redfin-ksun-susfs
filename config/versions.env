# KernelSU-Next legacy port with the KernelSU 3.4.2 backports for old kernels.
# The builder checks out the exact commit after fetching KSUN_REF. The legacy
# branch has a distinct commit-count history, so its upstream Kbuild override
# reports the matching v3.4.2 Manager compatibility code and tag below. SuSFS
# remains the reviewable built-in v2.2.0 redfin patch series.

GOOGLE_BASE_COMMIT=7b0944645172e8b690d42f68c8973ccb0ca45730
KSUN_VERSION=v3.4.2-legacy-backports
KSUN_REPO=https://github.com/KernelSU-Next/KernelSU-Next.git
KSUN_BRANCH=legacy
KSUN_TAG=v3.4.0-legacy
KSUN_REF=refs/heads/legacy
KSUN_EXPECTED_COMMIT=465490a26667ba4cf00b3be975a7e28e53978829
KSUN_VERSION_CODE=33553
KSUN_VERSION_TAG=v3.4.2
SUSFS_VERSION=v2.2.0
SUSFS_REFERENCE_REPO=https://github.com/sreeshankark/android_kernel_oneplus_avicii.git
SUSFS_REFERENCE_BRANCH=14
SUSFS_REFERENCE_COMMIT=3f46c9981373ab3796370bc89ecbb2e20f1d509e
SUSFS_REDFIN_PATCH=patches/susfs-v2.2.0-redbull.patch
SUSFS_REDFIN_PATCH_SHA256=2d047ff9103fc857e2cb21c9e9f58c71e2d82d0286b7d7dc8df618c9e0a9689c

