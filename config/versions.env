# Historical, known-working SuSFS v2.2.0 baseline for redfin.
# The legacy v2.2.0 builder reads KSUN_REF, KSUN_EXPECTED_COMMIT, and
# GOOGLE_BASE_COMMIT from config/versions.env. The remaining entries record
# the exact source and redfin patch provenance.

GOOGLE_BASE_COMMIT=7b0944645172e8b690d42f68c8973ccb0ca45730
KSUN_VERSION=v3.3.0-legacy-susfs-v2
KSUN_REPO=https://github.com/sidex15/KernelSU-Next.git
KSUN_BRANCH=legacy-susfs-v2
KSUN_TAG=v3.3.0-legacy-susfs-v2
KSUN_REF=v3.3.0-legacy-susfs-v2
KSUN_EXPECTED_COMMIT=36679224f26d03f2bb105c4686cf390eb63178c2
SUSFS_VERSION=v2.2.0
SUSFS_REFERENCE_REPO=https://github.com/sreeshankark/android_kernel_oneplus_avicii.git
