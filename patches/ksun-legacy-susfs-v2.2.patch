 #include <linux/version.h>
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 11, 0)
 #include <linux/sched/signal.h>
@@ -25,11 +26,72 @@
 #include "hook/hook_manager.h"
 #include "feature/kernel_umount.h"
 #include "compat/kernel_compat.h"
+#include "selinux/selinux.h"
+
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs.h>
+#include <linux/susfs_def.h>
+
+static bool is_zygote_isolated_service_uid(uid_t uid)
+{
+    uid %= 100000;
+    return uid >= 99000 && uid < 100000;
+}
+
+static bool is_zygote_normal_app_uid(uid_t uid)
+{
+    uid %= 100000;
+    return uid >= 10000 && uid < 19999;
+}
+
+extern u32 susfs_zygote_sid;
+extern struct cred *ksu_cred;
+extern struct work_struct susfs_extra_works;
+
+struct susfs_setuid_task_work {
+    struct callback_head cb;
+};
+
+static void susfs_setuid_task_work_fn(struct callback_head *cb)
+{
+    struct susfs_setuid_task_work *tw =
+        container_of(cb, struct susfs_setuid_task_work, cb);
+    const struct cred *saved = override_creds(ksu_cred);
+
+    revert_creds(saved);
+    kfree(tw);
+}
+
+static void ksu_handle_extra_susfs_work(void)
+{
+    struct susfs_setuid_task_work *tw;
+
+    if (work_pending(&susfs_extra_works))
+        return;
+
+    schedule_work(&susfs_extra_works);
+    tw = kzalloc(sizeof(*tw), GFP_ATOMIC);
+    if (!tw)
+        return;
+
+    tw->cb.func = susfs_setuid_task_work_fn;
+    if (task_work_add(current, &tw->cb, TWA_RESUME))
+        kfree(tw);
+}
+#endif
 
 int ksu_handle_setresuid(uid_t old_uid, uid_t new_uid)
 {
     // we rely on the fact that zygote always call setresuid(3) with same uids
 
+#ifdef CONFIG_KSU_SUSFS
+    if (!susfs_is_sid_equal(current_cred(), susfs_zygote_sid))
+        return 0;
+
+    if (is_zygote_isolated_service_uid(new_uid))
+        goto do_umount;
+#endif
+
     pr_info("handle_setresuid from %d to %d\n", old_uid, new_uid);
 
     if (unlikely(is_uid_manager(new_uid))) {
@@ -51,6 +112,11 @@ int ksu_handle_setresuid(uid_t old_uid, uid_t new_uid)
         return 0;
     }
 
+#ifdef CONFIG_KSU_SUSFS
+    if (is_zygote_normal_app_uid(new_uid) && ksu_uid_should_umount(new_uid))
+        goto do_umount;
+#endif
+
     if (ksu_is_allow_uid_for_current(new_uid)) {
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
         if (current->seccomp.mode == SECCOMP_MODE_FILTER && current->seccomp.filter) {
@@ -70,7 +136,20 @@ int ksu_handle_setresuid(uid_t old_uid, uid_t new_uid)
     }
 
     // Handle kernel umount
+#ifdef CONFIG_KSU_SUSFS
+    return 0;
+
+do_umount:
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+    susfs_try_umount(new_uid);
+#else
+    ksu_handle_umount(old_uid, new_uid);
+#endif
+    ksu_handle_extra_susfs_work();
+    susfs_set_current_proc_umounted();
+#else
     ksu_handle_umount(old_uid, new_uid);
+#endif
 
     return 0;
 }
