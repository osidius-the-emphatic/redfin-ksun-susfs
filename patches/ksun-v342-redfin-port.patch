 		ksu_syscall_hook_manager_init();
 
 		ksu_throne_tracker_init();
 		ksu_observer_init();
 		ksu_file_wrapper_init();
 
 		ksu_boot_completed = true;
 		track_throne(false);
 
 		ksu_feature_apply_forced();
 
 		if (!getenforce()) {
