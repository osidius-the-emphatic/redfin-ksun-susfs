+do_umount:
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+	susfs_try_umount(new_uid);
+#else
+	ksu_handle_umount(old_uid, new_uid);
+#endif
+	ksu_handle_extra_susfs_work();
+	susfs_set_current_proc_umounted();
+#else
+	ksu_handle_umount(old_uid, new_uid);
+#endif
 
     return 0;
 }
 
