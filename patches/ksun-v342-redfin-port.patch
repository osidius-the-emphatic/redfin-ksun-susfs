+static void susfs_setuid_task_work_fn(struct callback_head *cb)
+{
+	struct susfs_setuid_task_work *tw =
+		container_of(cb, struct susfs_setuid_task_work, cb);
+	const struct cred *saved = override_creds(ksu_cred);
+
+	revert_creds(saved);
+	kfree(tw);
+}
+
+static void ksu_handle_extra_susfs_work(void)
+{
+	struct susfs_setuid_task_work *tw;
