diff --git a/kernel/hook/arm64/syscall_hook.c b/kernel/hook/arm64/syscall_hook.c
--- a/kernel/hook/arm64/syscall_hook.c
+++ b/kernel/hook/arm64/syscall_hook.c
@@ -3,6 +3,7 @@
 #include "../syscall_hook.h"
 
 #include <linux/kallsyms.h>
 #include <linux/mutex.h>
+#include <linux/uaccess.h>
 #include <asm/cacheflush.h>
 #include "infra/symbol_resolver.h"
@@ -117,6 +117,27 @@ void ksu_syscall_table_unhook(int nr)
     mutex_unlock(&hooked_entries_lock);
     pr_warn("syscall %d not found in hooked entries\n", nr);
 }
 
+/*
+ * Clang CFI may place a short branch thunk in sys_call_table instead of the
+ * address returned for the named syscall symbol. Resolve one such thunk so
+ * the dispatcher can still find an unused sys_ni_syscall slot on 4.19.
+ */
+static unsigned long ksu_resolve_syscall_entry_target(unsigned long entry)
+{
+    u32 insn;
+    s64 offset;
+
+    if (!entry || probe_kernel_read(&insn, (void *)entry, sizeof(insn)))
+        return entry;
+    if ((insn & 0xfc000000) != 0x14000000)
+        return entry;
+
+    offset = (s64)(insn & 0x03ffffff);
+    if (offset & (1 << 25))
+        offset -= 1 << 26;
+    return entry + (unsigned long)(offset * 4);
+}
+
 static int __init ksu_find_ni_syscall_slots(int *out_slots, int max_slots)
 {
@@ -133,8 +154,11 @@ static int __init ksu_find_ni_syscall_slots(int *out_slots, int max_slots)
         return 0;
 
     for (i = 0; i < __NR_syscalls && count < max_slots; i++) {
-        if ((unsigned long)ksu_syscall_table[i] == ni_syscall) {
+        unsigned long entry = (unsigned long)READ_ONCE(ksu_syscall_table[i]);
+        unsigned long target = ksu_resolve_syscall_entry_target(entry);
+
+        if (entry == ni_syscall || target == ni_syscall) {
             out_slots[count++] = i;
             pr_info("ni_syscall %d: %d\n", count, i);
         }
     }
 
